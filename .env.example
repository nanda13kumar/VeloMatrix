# VeloMatrix — optional secrets for Docker Compose (NOT used for HTTP ports).
# Ports are defined only in application.properties at the repo root.
#
# Database (when wired)
DATABASE_URL=postgresql+asyncpg://velomatrix:velomatrix@localhost:5432/velomatrix

# GenAI (optional — stub mode when empty)
ANTHROPIC_API_KEY=

# Admin API key (optional — admin routes are open if empty, suitable for local dev)
# VELOMATRIX_ADMIN_API_KEY=changeme-for-production

# Connectors (optional — only used when bindings reference these integrations)
# LOKI_BASE_URL=https://loki.example.com
# LOKI_BEARER_TOKEN=
# SONARQUBE_URL=https://sonar.example.com
# SONARQUBE_TOKEN=
# GITHUB_TOKEN=
