# Backend-local secrets only (.env is optional). HTTP ports live in repo-root application.properties.
APP_NAME=VeloMatrix
DEBUG=true
DATABASE_URL=
ANTHROPIC_API_KEY=

# Admin API key (leave blank for open dev mode)
VELOMATRIX_ADMIN_API_KEY=

# Local workspace path (leave blank to use <repo>/local/demo-data/)
# VOLOMATRIX_DATA_BASE=

# Connector env vars (set only those whose connectors you wire in bindings.json)
# LOKI_BASE_URL=http://loki:3100
# LOKI_BEARER_TOKEN=
# PROMETHEUS_URL=http://prometheus:9090
# PROMETHEUS_BEARER_TOKEN=
# SONARQUBE_URL=https://sonar.example.com
# SONARQUBE_TOKEN=
# SNYK_TOKEN=
# SNYK_ORG_ID=
# GITHUB_TOKEN=
# TRIVY_REPORT_PATH=/path/to/report.json
